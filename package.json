{
  "name": "sapore-sdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "check": "npm run build && npm test",
    "preflight:sprint2": "node --env-file-if-exists=.env --import tsx scripts/preflight-sprint2.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
